@model CityberryTravel.Models.TravelDestination

@{
    ViewData["Title"] = "Destination Details";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="bg-gradient-to-r from-blue-500 to-blue-600 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-white">@Model.Name</h1>
        <p class="text-white/80 mt-2">Destination Details</p>
    </div>
</div>

<div class="container mx-auto px-4 py-10 max-w-5xl">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <!-- Destination Header -->
        <div class="bg-gray-50 p-6 border-b border-gray-100 flex justify-between items-center">
            <div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Active
                </span>
                <span class="ml-3 text-gray-500 text-sm">ID: @Model.Id</span>
            </div>
            <div class="flex space-x-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="-ml-1 mr-2 h-4 w-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                    Edit
                </a>
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="-ml-1 mr-2 h-4 w-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Back
                </a>
            </div>
        </div>

        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Main Information -->
                <div class="md:col-span-2 space-y-8">
                    <!-- Description Section -->
                    <div>
                        <div class="space-y-1 mb-4">
                            <h2 class="text-xl font-semibold text-gray-800">Description</h2>
                            <div class="h-1 w-20 bg-blue-500 rounded"></div>
                        </div>
                        
                        <div class="bg-gray-50 p-6 rounded-lg">
                            @if (string.IsNullOrEmpty(Model.Description))
                            {
                                <p class="text-gray-500 italic">No description provided</p>
                            }
                            else
                            {
                                <p class="text-gray-700 whitespace-pre-line">@Model.Description</p>
                            }
                        </div>
                    </div>
                    
                    <!-- Available Dates -->
                    <div>
                        <div class="space-y-1 mb-4">
                            <h2 class="text-xl font-semibold text-gray-800">Available Dates & Times</h2>
                            <div class="h-1 w-20 bg-blue-500 rounded"></div>
                        </div>
                        
                        @if (Model.AvailableDates == null || !Model.AvailableDates.Any())
                        {
                            <p class="text-gray-500 italic">No available dates</p>
                        }
                        else
                        {
                            <div class="overflow-hidden bg-white border border-gray-200 rounded-lg">
                                <ul class="divide-y divide-gray-200">
                                    @foreach (var date in Model.AvailableDates.OrderBy(d => d))
                                    {
                                        <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
                                            <div class="flex items-center">
                                                <svg class="h-5 w-5 text-blue-500 mr-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                                                </svg>
                                                <span class="text-gray-700">@date.ToString("MMMM d, yyyy")</span>
                                            </div>
                                            <div class="flex items-center">
                                                <svg class="h-4 w-4 text-blue-500 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                                </svg>
                                                <span class="text-blue-600 font-medium">@date.ToString("HH:mm")</span>
                                                <span class="text-sm text-gray-500 ml-3">@date.DayOfWeek</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Side Information Panel -->
                <div>
                    <div class="bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
                        <div class="px-6 py-4 bg-gray-100 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Destination Details</h3>
                        </div>
                        <div class="px-6 py-4 space-y-6">
                            <!-- Price -->
                            <div>
                                <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Price</h4>
                                <div class="flex items-baseline">
                                    <span class="text-2xl font-bold text-gray-900">@Html.DisplayFor(model => model.Price)</span>
                                    <span class="ml-1 text-sm text-gray-500">per person</span>
                                </div>
                            </div>
                            
                            <!-- Basic Info -->
                            <div class="pt-4 border-t border-gray-200">
                                <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Basic Information</h4>
                                <dl class="space-y-3">
                                    <div class="flex justify-between">
                                        <dt class="text-sm text-gray-600">ID</dt>
                                        <dd class="text-sm font-medium text-gray-900">@Model.Id</dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-sm text-gray-600">Name</dt>
                                        <dd class="text-sm font-medium text-gray-900">@Model.Name</dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-sm text-gray-600">Total Available Dates</dt>
                                        <dd class="text-sm font-medium text-gray-900">@(Model.AvailableDates?.Count ?? 0)</dd>
                                    </div>
                                </dl>
                            </div>
                            
                            <!-- Actions -->
                            <div class="pt-4 border-t border-gray-200">
                                <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Actions</h4>
                                <div class="space-y-2">
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="w-full flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        <svg class="-ml-1 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                        </svg>
                                        Edit Destination
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                        <svg class="-ml-1 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                        </svg>
                                        Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 
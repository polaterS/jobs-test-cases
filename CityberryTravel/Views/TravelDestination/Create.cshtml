@model CityberryTravel.Models.TravelDestination

@{
    ViewData["Title"] = "Create Destination";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="bg-gradient-to-r from-blue-500 to-indigo-600 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-white">Create Destination</h1>
        <p class="text-white/80 mt-2">Add a new travel destination to your collection</p>
    </div>
</div>

<div class="container mx-auto px-4 py-10 max-w-5xl">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl">
        <div class="p-8">
            <form asp-action="Create" id="createForm" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded"></div>
                
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-6">
                    <!-- Name Field -->
                    <div class="space-y-2">
                        <label asp-for="Name" class="block text-gray-700 font-medium"></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-map-marker-alt text-gray-400"></i>
                            </div>
                            <input asp-for="Name" placeholder="Enter destination name" class="pl-10 w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                        </div>
                        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                    </div>
                    
                    <!-- Price Field -->
                    <div class="space-y-2">
                        <label asp-for="Price" class="block text-gray-700 font-medium"></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-tag text-gray-400"></i>
                            </div>
                            <input asp-for="Price" type="number" step="0.01" placeholder="0.00" class="pl-10 w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                        </div>
                        <span asp-validation-for="Price" class="text-red-500 text-sm"></span>
                    </div>
                </div>
                
                <!-- Description Field -->
                <div class="space-y-2">
                    <label asp-for="Description" class="block text-gray-700 font-medium"></label>
                    <div class="relative">
                        <div class="absolute top-3 left-3 text-gray-400">
                            <i class="fas fa-align-left"></i>
                        </div>
                        <textarea asp-for="Description" rows="4" placeholder="Describe this destination..." class="pl-10 w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                </div>
                
                <!-- Available Dates -->
                <div class="space-y-3">
                    <label class="block text-gray-700 font-medium">Available Dates & Times</label>
                    <div id="dates-container" class="space-y-3">
                        <div class="flex items-center gap-2 animate-fade-in">
                            <div class="relative flex-grow">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-calendar-alt text-gray-400"></i>
                                </div>
                                <input type="datetime-local" name="AvailableDates[0]" class="pl-10 w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all date-time-input" />
                            </div>
                            <button type="button" class="delete-date text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 p-3 rounded-lg transition-colors">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" id="add-date" class="inline-flex items-center text-green-600 hover:text-green-800 bg-green-50 hover:bg-green-100 px-4 py-2 rounded-lg font-medium transition-colors">
                        <i class="fas fa-plus mr-2"></i> Add Date & Time
                    </button>
                </div>
                
                <!-- Action Buttons -->
                <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row gap-4 justify-between items-center">
                    <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 inline-flex items-center justify-center transition-colors">
                        <i class="fas fa-save mr-2"></i> Create Destination
                    </button>
                    <a asp-action="Index" class="w-full sm:w-auto inline-flex items-center justify-center text-gray-600 hover:text-gray-800 font-medium py-3 px-6 border border-gray-300 hover:border-gray-400 rounded-lg transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            let dateIndex = 1;
            
            // Add new date field
            $("#add-date").click(function() {
                const newDateField = `
                    <div class="flex items-center gap-2 animate-fade-in">
                        <div class="relative flex-grow">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-calendar-alt text-gray-400"></i>
                            </div>
                            <input type="datetime-local" name="AvailableDates[${dateIndex}]" class="pl-10 w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all date-time-input" />
                        </div>
                        <button type="button" class="delete-date text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 p-3 rounded-lg transition-colors">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
                $("#dates-container").append(newDateField);
                dateIndex++;
            });
            
            // Delete date field
            $(document).on("click", ".delete-date", function() {
                if ($("#dates-container").children().length > 1) {
                    $(this).parent().fadeOut(300, function() {
                        $(this).remove();
                        // Yeniden sırala
                        reindexDateFields();
                    });
                } else {
                    alert("You must have at least one date available");
                }
            });
            
            // Form gönderilmeden önce doğrulama yap
            $("#createForm").on("submit", function(e) {
                // Form gönderilmeden önce tüm input alanlarını kontrol edelim
                let hasEmptyDate = false;
                
                $("input[type='datetime-local']").each(function() {
                    if (!$(this).val()) {
                        hasEmptyDate = true;
                    }
                });
                
                if (hasEmptyDate) {
                    e.preventDefault();
                    alert("Please fill in all date and time fields");
                    return false;
                }
                
                // İndeksleri yeniden düzenle
                reindexDateFields();
                
                // Form submit işlemine devam et
                return true;
            });
            
            // İndeksleri yeniden düzenle
            function reindexDateFields() {
                let newIndex = 0;
                $("#dates-container input[type='datetime-local']").each(function() {
                    const oldName = $(this).attr("name");
                    const newName = "AvailableDates[" + newIndex + "]";
                    $(this).attr("name", newName);
                    newIndex++;
                });
            }
        });
    </script>
    
    <style>
        .animate-fade-in {
            animation: fadeIn 0.5s ease-in-out forwards;
        }
        
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
} 
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CityberryTravel</title>
    <script type="importmap"></script>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CityberryTravel.styles.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
    <header class="sticky top-0 z-50">
        <!-- Desktop Navigation -->
        <nav class="bg-white backdrop-filter backdrop-blur-lg bg-opacity-80 border-b border-gray-200 shadow-sm">
            <div class="container mx-auto px-4">
                <div class="flex justify-between h-20">
                    <!-- Logo and Desktop Menu -->
                    <div class="flex items-center">
                        <div class="flex-shrink-0 flex items-center">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="transition-transform hover:scale-105 duration-300">
                                <img src="~/images/cityberry-logo.svg" alt="Cityberry Logo" class="h-10" />
                            </a>
                        </div>
                        <div class="hidden md:ml-10 md:flex md:space-x-8 items-center">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "text-blue-600 border-b-2 border-blue-600" : "text-gray-500 hover:text-blue-600 hover:border-b-2 hover:border-blue-600") font-medium transition-all duration-200 py-6">
                                Home
                            </a>
                            <a asp-area="" asp-controller="TravelDestination" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "TravelDestination" ? "text-blue-600 border-b-2 border-blue-600" : "text-gray-500 hover:text-blue-600 hover:border-b-2 hover:border-blue-600") font-medium transition-all duration-200 py-6">
                                Destinations
                            </a>
                            <a href="/swagger" target="_blank" class="text-gray-500 hover:text-blue-600 hover:border-b-2 hover:border-blue-600 font-medium transition-all duration-200 py-6">
                                API Docs
                            </a>
                        </div>
                    </div>
                    
                    <!-- Contact Button (Desktop) -->
                    <div class="hidden md:flex md:items-center">
                        <a href="mailto:support@cityberry.com" class="inline-flex items-center px-4 py-2 border border-blue-500 text-blue-600 bg-white hover:bg-blue-50 rounded-full text-sm font-medium transition-colors duration-300">
                            <i class="fas fa-envelope mr-2"></i> Contact Us
                        </a>
                    </div>
                    
                    <!-- Mobile Menu Button -->
                    <div class="flex items-center md:hidden">
                        <button id="mobile-menu-button" class="text-gray-500 hover:text-blue-600 focus:outline-none">
                            <i class="fas fa-bars text-2xl"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Mobile Menu -->
            <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-inner">
                <div class="container mx-auto px-4 py-3 space-y-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "text-blue-600" : "text-gray-600") block py-3 font-medium">
                        <i class="fas fa-home mr-2"></i> Home
                    </a>
                    <a asp-area="" asp-controller="TravelDestination" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "TravelDestination" ? "text-blue-600" : "text-gray-600") block py-3 font-medium">
                        <i class="fas fa-globe-americas mr-2"></i> Destinations
                    </a>
                    <a href="/swagger" target="_blank" class="text-gray-600 block py-3 font-medium">
                        <i class="fas fa-code mr-2"></i> API Docs
                    </a>
                    <a href="mailto:support@cityberry.com" class="flex items-center py-3 text-gray-600 font-medium">
                        <i class="fas fa-envelope mr-2"></i> Contact Us
                    </a>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="flex-grow">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-t border-gray-200 py-10 mt-8">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <!-- Logo ve İletişim -->
                <div class="flex flex-col space-y-4">
                    <div class="mb-2">
                        <img src="~/images/cityberry-logo.svg" alt="Cityberry Logo" class="h-12" />
                    </div>
                    <p class="text-gray-600 text-sm">Creating destination based innovative services and cutting-edge technologies for travel sector since 1995.</p>
                </div>
                
                <!-- Adres Bilgileri -->
                <div class="text-gray-600">
                    <p class="font-medium text-gray-800 mb-3">Cityberry Travel Technologies Ltd.</p>
                    <address class="not-italic text-sm space-y-1">
                        <p>Dubai International Financial Centre</p>
                        <p>The Gate Building, Level 14, P. O.</p>
                        <p>Dubai / United Arab Emirates</p>
                    </address>
                </div>
                
                <!-- İletişim ve Sosyal Medya -->
                <div class="text-gray-600">
                    <div class="mb-4">
                        <p class="mb-1 text-sm flex items-center">
                            <i class="fas fa-envelope mr-2 text-blue-500"></i>
                            <a href="mailto:support@cityberry.com" class="hover:text-blue-600 transition-colors">support@cityberry.com</a>
                        </p>
                        <p class="text-sm flex items-center">
                            <i class="fas fa-phone mr-2 text-blue-500"></i>
                            <a href="tel:+905303852026" class="hover:text-blue-600 transition-colors">+90 530 385 2026</a>
                        </p>
                    </div>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-500 hover:text-blue-600 transition-colors">
                            <i class="fab fa-linkedin text-xl"></i>
                        </a>
                        <a href="#" class="text-gray-500 hover:text-blue-600 transition-colors">
                            <i class="fab fa-twitter text-xl"></i>
                        </a>
                        <a href="#" class="text-gray-500 hover:text-blue-600 transition-colors">
                            <i class="fab fa-facebook text-xl"></i>
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="pt-6 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
                <div>
                    <p>Copyright © @DateTime.Now.Year Cityberry® - All Rights Reserved</p>
                </div>
            </div>
        </div>
    </footer>
    
    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <!-- Custom Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Mobile Menu Toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenu.classList.toggle('hidden');
        });
        
        // Header Scroll Effect
        window.addEventListener('scroll', function() {
            const header = document.querySelector('header');
            if (window.scrollY > 0) {
                header.classList.add('shadow');
            } else {
                header.classList.remove('shadow');
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
